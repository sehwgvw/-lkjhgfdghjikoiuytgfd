# ─── Telegram ──────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=
# ID и hash приложения с my.telegram.org
API_ID=
API_HASH=
# Имя сессии юзербота (по умолчанию alyaska_userbot)
SESSION_NAME=alyaska_userbot
# 2FA-пароль на аккаунте юзербота (для передачи владельца, опционально)
USERBOT_2FA_PASSWORD=

# ─── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/alyaska

# ─── Доступ ────────────────────────────────────────────────
# Telegram ID, которым разрешено пользоваться ботом (создание сделок, +команда)
ALLOWED_USER_IDS=

# ─── Пул сделочных ─────────────────────────────────────────
# Сколько групп-сделочных держать наготове (50-70)
POOL_SIZE=50
# Раз в сколько секунд проверять и пополнять пул
POOL_REFILL_INTERVAL_SECONDS=180

# ─── Юзерботы ──────────────────────────────────────────────
# Пауза после тяжёлой операции для аккаунта (сек)
SESSION_COOLDOWN_SECONDS=120

# ─── Реквизиты (опционально, дефолты уже проставлены) ─────
OWNER_USERNAME=Valigonov
DEVELOPER_USERNAME=NyawkaCuteUwU
BOT_USERNAME=AlyaskaGarantBot
RULES_URL=https://t.me/ValigonovRules/17
